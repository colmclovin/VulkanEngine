#version 450
#extension GL_GOOGLE_include_directive : require
#include "Include/noise.glsl"

layout(local_size_x = 1) in;

layout(std430, binding = 0) buffer DebugOutput {
    vec4 debugValues[9];   // CHANGED — was 8, now 9 to fit mPreSquare
};

layout(push_constant) uniform PushConstants {
    vec2 testPoint;
} pc;

void main() {
    vec2 v = pc.testPoint;
    const vec4 C = vec4(0.211324865405187, 0.366025403784439, -0.577350269189626, 0.024390243902439);
    vec2 i = floor(v + dot(v, C.yy));
    vec2 x0 = v - i + dot(i, C.xx);
    vec2 i1 = (x0.x > x0.y) ? vec2(1.0, 0.0) : vec2(0.0, 1.0);
    vec4 x12 = x0.xyxy + C.xxzz;
    x12.xy -= i1;
    vec2 iMod = mod(i, 289.0);
    vec3 p = permute(permute(iMod.y + vec3(0.0, i1.y, 1.0)) + iMod.x + vec3(0.0, i1.x, 1.0));

    vec3 mPreSquare = max(0.5 - vec3(dot(x0, x0), dot(x12.xy, x12.xy), dot(x12.zw, x12.zw)), 0.0);
    vec3 m = (mPreSquare * mPreSquare) * (mPreSquare * mPreSquare);   // explicit squaring, replaces m=m*m;m=m*m;

    vec3 x = 2.0 * fract(p * C.www) - 1.0;
    vec3 h = abs(x) - 0.5;
    vec3 ox = floor(x + 0.5);
    vec3 a0 = x - ox;
    m *= 1.79284291400159 - 0.85373472095314 * (a0 * a0 + h * h);
    vec3 g;
    g.x = a0.x * x0.x + h.x * x0.y;
    g.yz = a0.yz * x12.xz + h.yz * x12.yw;
    float result = 130.0 * dot(m, g);

    debugValues[0] = vec4(i, 0, 0);
    debugValues[1] = vec4(x0, 0, 0);
    debugValues[2] = vec4(i1, 0, 0);
    debugValues[3] = x12;
    debugValues[4] = vec4(p, 0);
    debugValues[5] = vec4(mPreSquare, 0);
    debugValues[6] = vec4(m, 0);
    debugValues[7] = vec4(g, 0);
    debugValues[8] = vec4(result, 0, 0, 0);
}