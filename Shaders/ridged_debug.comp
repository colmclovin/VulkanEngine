// Shaders/ridged_debug.comp — new diagnostic shader
#version 450
#extension GL_GOOGLE_include_directive : require
#include "Include/noise.glsl"

layout(local_size_x = 1) in;

layout(std430, binding = 0) buffer DebugOutput {
    vec4 debugValues[4];   // one per octave's running sum, plus final
};

layout(push_constant) uniform PushConstants {
    vec2 pos;
    int octaves;
    float frequency;
    float lacunarity;
    float gain;
} pc;

void main() {
    float sum = 0.0;
    float amplitude = 0.5;
    float freq = pc.frequency;
    for (int i = 0; i < pc.octaves; i++) {
        float n = abs(simplexNoise2D(pc.pos * freq));
        n = 1.0 - n;
        n = n * n;
        sum += n * amplitude;
        freq *= pc.lacunarity;
        amplitude *= pc.gain;
        if (i < 3) debugValues[i] = vec4(sum, n, amplitude, freq);   // capture each octave's state
    }
    debugValues[3] = vec4(sum, 0, 0, 0);   // final result
}