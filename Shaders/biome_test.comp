// Shaders/biome_test.comp
#version 450
#extension GL_GOOGLE_include_directive : require

#include "Include/terrain.glsl"

layout(local_size_x = 64) in;

layout(std430, binding = 0) buffer OutputBuffer {
    float values[];
};

layout(push_constant) uniform PushConstants {
    float startX;
    float startZ;
    float spacing;
    float seed;
    uint sampleType;   // 0 = aridity, 1 = elevationTrigger, 2 = latitude, 3 = determineBiome
} pc;

void main() {
    uint idx = gl_GlobalInvocationID.x;
    float x = pc.startX + float(idx) * pc.spacing;
    float z = (pc.sampleType == 2 || pc.sampleType == 3) ? (pc.startZ + float(idx) * pc.spacing) : pc.startZ;

    if (pc.sampleType == 0) {
        values[idx] = getAridity(x, z, pc.seed);
    } else if (pc.sampleType == 1) {
    values[idx] = getElevationTrigger(x, z, pc.seed);   // REVERTED — back to the real function
    } else if (pc.sampleType == 2) {
        values[idx] = getLatitude(z);
    } else if (pc.sampleType == 3) {
        values[idx] = float(determineBiome(x, z, pc.seed));
    } else if (pc.sampleType == 4) {
    vec4 noDepletion[4] = vec4[4](vec4(0.0), vec4(0.0), vec4(0.0), vec4(0.0));
    values[idx] = sampleTerrain(x, z, pc.seed, 0u, noDepletion).height;
    } else if (pc.sampleType == 5) {
    float v = 0.0;
    if (idx == 0u) v = getElevationTrigger(x, z, pc.seed);
    else if (idx == 1u) v = sampleRawHeightForBiome(x, z, BIOME_HILLS, pc.seed);
    else if (idx == 2u) v = sampleRawHeightForBiome(x, z, BIOME_MOUNTAINS, pc.seed);
    else if (idx == 3u) v = sampleRawHeightForBiome(x, z, BIOME_PLAINS, pc.seed);
    else if (idx == 4u) v = float(determineBiome(x, z, pc.seed));
    else if (idx == 5u) v = getAridity(x, z, pc.seed);
    else if (idx == 6u) v = hashSeed(pc.seed);
    else if (idx == 7u) v = pc.seed;   // confirms what the GPU actually received
    values[idx] = v;
}
}