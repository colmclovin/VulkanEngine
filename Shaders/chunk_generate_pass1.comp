// Shaders/chunk_generate_pass1.comp
#version 450
#extension GL_GOOGLE_include_directive : require

#include "Include/terrain.glsl"

layout(local_size_x = 8, local_size_y = 8) in;

layout(std430, binding = 0) buffer PaddedPositionBuffer {
    vec4 paddedPositions[];   // xyz = position, w unused (padding for alignment/future use)
};

layout(std430, binding = 1) buffer PaddedColorBuffer {
    vec4 paddedColors[];      // xyz = color
};

layout(push_constant) uniform PushConstants {
    float chunkOriginX;
    float chunkOriginZ;
    float cellSize;
    float seed;
    uint vertexResolution;
    uint paddedRes;
    uint depletionCount;              // NEW — how many of the 8 slots below are actually used
    vec4 depletionEntries[4];         // NEW — xy = world grid coord, z = remainingFraction, w unused
} pc;

void main() {
    uint gx = gl_GlobalInvocationID.x;
    uint gz = gl_GlobalInvocationID.y;
    if (gx >= pc.paddedRes || gz >= pc.paddedRes) return;

    float worldX = pc.chunkOriginX + (float(gx) - 1.0) * pc.cellSize;
    float worldZ = pc.chunkOriginZ + (float(gz) - 1.0) * pc.cellSize;

TerrainSample terrainSample = sampleTerrain(worldX, worldZ, pc.seed, pc.depletionCount, pc.depletionEntries);
    uint idx = gz * pc.paddedRes + gx;
    paddedPositions[idx] = vec4(worldX, terrainSample.height, worldZ, 0.0);
    paddedColors[idx] = vec4(terrainSample.color, 0.0);
}